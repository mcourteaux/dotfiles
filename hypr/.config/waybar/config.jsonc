// wlperch full bar, backup: config.jsonc.before-wlperch-full
// The complete wlperch bar for sway: workspaces on the left, wlperch's
// buttons on the right. Installed by `wlperch setup` ("Replace whole bar"),
// which keeps your own config as config.jsonc.before-wlperch-full; "Restore
// my bar" puts it back. The wlperch modules are defined in wlperch.jsonc.
{
    "spacing": 0,
    "include": ["wlperch.jsonc"],
    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "sway/scratchpad",
        "sway/window"
    ],
    "modules-center": [],
    // Audio, network, CPU/GPU, temperatures, keyboard layout, clocks:
    // all live in the wlperch popup (rightmost button).
    "modules-right": [
        "idle_inhibitor",
        "power-profiles-daemon",
        "backlight",
        "battery",
        "group/media",
        "custom/timer",
        "custom/sensors",
        "memory",
        "clock",
        "tray",
        "custom/notifications",
        "custom/wlperch"
    ],
    "sway/window": {
        "max-length": 90
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },
    "backlight": {
        "format": "{percent}% {icon}",
        "format-icons": ["🌑", "🌘", "🌗", "🌖", "🌕"]
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    "clock": {
        "interval": 5,
        "format": "{:%a %d %b  <b>%H:%M</b>}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "wlperch toggle"
    },
    "tray": {
        "icon-size": 23,
        "spacing": 10
    }
}
